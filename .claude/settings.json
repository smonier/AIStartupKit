{
  "enabledMcpjsonServers": ["jahia"],
  "permissions": {
    "allow": [
      "Bash(yarn build)",
      "Bash(yarn jahia-deploy)",
      "Bash(yarn build && yarn jahia-deploy)",
      "Bash(yarn install)",
      "Bash(yarn lint)",
      "Bash(yarn test *)",
      "Bash(docker compose *)",
      "Bash(docker logs *)",
      "Bash(mvn clean install *)",
      "Bash(mvn archetype:generate *)",
      "Bash(mvn dependency:resolve *)",
      "Bash(curl -s * http://localhost:8080/*)",
      "Bash(curl -X POST http://localhost:8080/modules/graphql)",
      "Bash(find . -name \"*.cnd\" *)",
      "Bash(find . -name \"*.tsx\" *)",
      "Bash(find . -name \"*.ts\" *)",
      "Bash(find . -name \"package.json\" *)",
      "Bash(find src *)",
      "Bash(grep -r * src/)",
      "Bash(grep -r * .agents/)",
      "WebFetch(http://localhost:8080/*)"
    ]
  }
}
